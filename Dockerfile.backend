FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps for asyncpg / psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libpq-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

EXPOSE 8000

# Production: gunicorn with 2 uvicorn workers.
# 2 workers = good concurrency on 256MB free VM without OOM.
# Each worker handles async requests so 2x workers = ~2x throughput.
CMD ["gunicorn", "main:app", "-k", "uvicorn.workers.UvicornWorker", "-w", "2", "--bind", "0.0.0.0:8000", "--timeout", "60", "--graceful-timeout", "30", "--log-level", "info"]