FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps for asyncpg / psycopg2 (gateway imports backend modules)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libpq-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install gateway deps, then backend deps (gateway imports backend modules)
COPY telegram_gateway/requirements.txt ./gateway_requirements.txt
RUN pip install --no-cache-dir -r gateway_requirements.txt

COPY backend/requirements.txt ./backend_requirements.txt
RUN pip install --no-cache-dir -r backend_requirements.txt

# Copy both codebases — gateway imports from backend
COPY backend/ ./backend/
COPY telegram_gateway/ ./telegram_gateway/

RUN mkdir -p /app/data

ENV PYTHONPATH=/app

CMD ["python", "-m", "telegram_gateway.bot_manager"]
